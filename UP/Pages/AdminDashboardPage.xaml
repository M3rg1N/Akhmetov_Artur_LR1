<Page x:Class="BanID.Pages.AdminDashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,0,10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <DataTemplate x:Key="RequestCardTemplate">
            <Border Background="White" CornerRadius="6" Padding="20" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" Foreground="#21312D" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Description}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#46544F" LineHeight="20"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                Visibility="{Binding CanReview, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="Одобрить"
                                Height="34"
                                Tag="{Binding ID_Request}"
                                Background="#2F6D5A"
                                Foreground="White"
                                Click="ApproveRequest_Click"/>
                        <Button Content="Отклонить"
                                Height="34"
                                Margin="0,10,0,0"
                                Tag="{Binding ID_Request}"
                                Background="#A43B36"
                                Foreground="White"
                                Click="RejectRequest_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Панель администратора"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#21312D"/>
            <TextBlock Text="Заявки разделены по состоянию. Обработанные заявки нельзя одобрить или отклонить повторно."
                       Margin="0,10,0,20"
                       Foreground="#56645F"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#E5ECE9" CornerRadius="6" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TBoxSearch"
                         Height="38"
                         FontSize="15"
                         TextChanged="Search_TextChanged"
                         ToolTip="Поиск по ID, клиенту, типу, статусу или тексту заявки"/>
                <Button Grid.Column="2"
                        Content="Обновить"
                        Background="#DDE8E4"
                        Click="Refresh_Click"/>
            </Grid>
        </Border>

        <TabControl x:Name="TCRequests" Grid.Row="2" SelectionChanged="RequestsTab_Changed">
            <TabItem Header="На рассмотрении">
                <ListBox x:Name="LBPendingRequests"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ItemTemplate="{StaticResource RequestCardTemplate}"/>
            </TabItem>
            <TabItem Header="Принятые">
                <ListBox x:Name="LBApprovedRequests"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ItemTemplate="{StaticResource RequestCardTemplate}"/>
            </TabItem>
            <TabItem Header="Отклоненные">
                <ListBox x:Name="LBRejectedRequests"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ItemTemplate="{StaticResource RequestCardTemplate}"/>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
