<Page x:Class="BanID.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <Page.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,0,10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="10,0,10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Page.Resources>
    <Grid>
        <StackPanel VerticalAlignment="Center" Margin="10">
            <TextBlock Text="Вход в систему"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#21312D"/>
            <TextBlock Text="Введите телефон, указанный при регистрации."
                       Margin="0,10,0,30"
                       Foreground="#56645F"/>

            <TextBlock Text="Телефон" FontWeight="SemiBold"/>
            <TextBox x:Name="TBoxLogin" Height="42" Margin="0,10,0,20" FontSize="16"/>

            <TextBlock Text="Пароль" FontWeight="SemiBold"/>
            <PasswordBox x:Name="PBPassword" Height="42" Margin="0,10,0,20" FontSize="16"/>

            <TextBlock Text="Защищенная капча" FontWeight="SemiBold"/>
            <Grid Margin="0,10,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <Border Background="#E5ECE9" CornerRadius="6" Padding="6">
                    <Canvas x:Name="CaptchaCanvas" Width="178" Height="52"/>
                </Border>
                <TextBox x:Name="TBoxCaptcha" Grid.Column="2" Height="42" FontSize="16"/>
                <Button Grid.Column="3" Content="↻" Click="RefreshCaptcha_Click" Margin="10,0,0,0"/>
            </Grid>

            <TextBlock x:Name="TBError"
                       Foreground="#B3261E"
                       TextWrapping="Wrap"
                       MinHeight="24"/>

            <Button Content="Войти"
                    Height="44"
                    Margin="0,10,0,10"
                    Background="#2F6D5A"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="Login_Click"/>

            <Button Content="Зарегистрироваться"
                    Height="40"
                    Background="#DDE8E4"
                    Foreground="#21312D"
                    Click="OpenRegister_Click"/>
        </StackPanel>
    </Grid>
</Page>
