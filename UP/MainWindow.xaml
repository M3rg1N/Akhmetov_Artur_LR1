<Window x:Class="BanID.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BanID - вход" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7F6">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.35*"/>
            <ColumnDefinition Width="0.65*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#21312D" Padding="40">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="BanID"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Padding="40">
            <Frame x:Name="FAuth" NavigationUIVisibility="Hidden"/>
        </Border>
    </Grid>
</Window>
