<Window x:Class="BanID.Windows.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BanID - кабинет" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7F6">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#21312D" Padding="30">
            <StackPanel>
                <StackPanel>
                    <TextBlock Text="Личный кабинет"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="TBUserName"
                               Margin="0,15,0,0"
                               Foreground="#DCE7E3"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="TBRole"
                               Margin="0,10,0,30"
                               Foreground="#AFC3BC"/>
                </StackPanel>

                <Button Content="Выйти"
                        Height="40"
                        Background="#DDE8E4"
                        Foreground="#21312D"
                        Click="Logout_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Padding="35">
            <Frame x:Name="FDashboard" NavigationUIVisibility="Hidden"/>
        </Border>
    </Grid>
</Window>
